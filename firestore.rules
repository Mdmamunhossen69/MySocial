rules_version = '2';

// MySocial — Cloud Firestore security rules.
//
// Staff roles live ONLY in /admins/{uid} (field `role` MUST be exactly super_admin | admin | moderator).
// A document with a missing or unknown role gives NO staff power at all (fail closed).
// Normal users can never write to /admins. Only a super_admin can add or change staff.
// AI bots are plain profile docs (users/bot_NN, isBot == true) with no Firebase Auth login.
// Only staff or the low-privilege "bot runner" account can write as a bot.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // --- staff roles ---
    // Fail closed: no role (or an unknown role) = not staff. Never default to a powerful role.
    // (call signedIn() first; one exists() + one get() per call)
    function roleOf() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        ? get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('role', 'none')
        : 'none';
    }
    function isStaff() {
      return signedIn() && roleOf() in ['super_admin', 'admin', 'moderator'];
    }
    function isStaffUid(uid) {
      return exists(/databases/$(database)/documents/admins/$(uid));
    }
    function isSuper() {
      return signedIn() && roleOf() == 'super_admin';
    }
    // "admin" in the rest of this file means admin OR super_admin
    function isAdmin() {
      return signedIn() && roleOf() in ['super_admin', 'admin'];
    }
    function isMod() {
      return signedIn() && roleOf() == 'moderator';
    }

    // The automation account used by the scheduled GitHub Action: a normal Firebase Auth user whose
    // uid has a document in /botRunners (created by hand). It can only act as AI bots (see below).
    function isBotRunner() {
      return signedIn() && exists(/databases/$(database)/documents/botRunners/$(request.auth.uid));
    }

    // EMERGENCY KILL SWITCH, enforced here and not only in the script. Fail-closed: bots are ON only while
    // settings/global exists AND botsEnabled is explicitly true. A missing document makes get() fail, which denies.
    function botsOn() {
      return get(/databases/$(database)/documents/settings/global).data.get('botsEnabled', false) == true;
    }
    // The runner may WRITE only while the kill switch is on AND its uid is not also a staff account.
    // (A runner uid in /admins loses its runner power; the runner is a machine account, not a person.)
    function runnerOn() {
      return isBotRunner() && botsOn() && !isStaffUid(request.auth.uid);
    }

    // Not blocked and not under a temporary suspension.
    function notBanned() {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return signedIn()
        && u.banned != true
        && (u.get('suspendedUntil', null) == null || u.get('suspendedUntil', null) < request.time);
    }

    function pairId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }
    function textOk(v, max) {
      return v is string && v.size() <= max;
    }
    function groupDoc(gid) {
      return get(/databases/$(database)/documents/groups/$(gid)).data;
    }
    function canSeePost(p) {
      return p.visibility == 'public'
        || request.auth.uid in p.audience
        || (p.visibility == 'group' && request.auth.uid in groupDoc(p.groupId).members);
    }
    function isBotUser(id) {
      return exists(/databases/$(database)/documents/users/$(id))
        && get(/databases/$(database)/documents/users/$(id)).data.get('isBot', false) == true;
    }
    // AI bots may only react / comment on posts of other bots or of users who switched on
    // Settings -> "Allow AI bots to react and comment" (users/{uid}.settings.allowBotEngagement).
    function engagementOk(ownerUid) {
      return isBotUser(ownerUid)
        || get(/databases/$(database)/documents/users/$(ownerUid)).data.get('settings', {}).get('allowBotEngagement', false) == true;
    }
    // comment rules read the post once (`let`) instead of once per condition
    function userMayComment(postId) {
      let p = get(/databases/$(database)/documents/posts/$(postId)).data;
      return p.get('commentsDisabled', false) == false && canSeePost(p);
    }
    function botMayComment(postId) {
      let p = get(/databases/$(database)/documents/posts/$(postId)).data;
      return p.get('commentsDisabled', false) == false && p.visibility == 'public' && engagementOk(p.uid);
    }
    function botIds() {
      return ['bot_01', 'bot_02', 'bot_03', 'bot_04', 'bot_05', 'bot_06', 'bot_07', 'bot_08', 'bot_09', 'bot_10',
              'bot_11', 'bot_12', 'bot_13', 'bot_14', 'bot_15', 'bot_16', 'bot_17', 'bot_18', 'bot_19', 'bot_20',
              'bot_21', 'bot_22', 'bot_23', 'bot_24', 'bot_25', 'bot_26', 'bot_27', 'bot_28', 'bot_29', 'bot_30'];
    }
    function validPost(d) {
      return textOk(d.text, 5000)
        && d.visibility in ['public', 'friends', 'me', 'group']
        && d.audience is list
        && d.audience.size() <= 1500
        && d.reactions == {}
        && d.commentCount == 0
        && d.shareCount == 0;
    }
    function nameOk(d) {
      return textOk(d.name, 60) && d.name.size() >= 2 && textOk(d.bio, 500);
    }

    // ---------- staff ----------
    match /admins/{uid} {
      allow read: if isOwner(uid) || isSuper();
      // only a super_admin manages staff, and never their own entry
      // Only a super_admin, never for themselves, only for a real (non-bot) existing user,
      // with a known role and nothing but the expected fields.
      allow create, update: if isSuper()
        && uid != request.auth.uid
        && !uid.matches('bot_.*')
        && !exists(/databases/$(database)/documents/botRunners/$(uid))
        && exists(/databases/$(database)/documents/users/$(uid))
        && request.resource.data.keys().hasOnly(['role', 'addedBy', 'addedAt'])
        && request.resource.data.role in ['super_admin', 'admin', 'moderator']
        && request.resource.data.addedBy == request.auth.uid;
      allow delete: if isSuper() && uid != request.auth.uid;
    }

    // every staff action is logged by the client; nobody can edit or delete a log entry
    match /adminLogs/{id} {
      // a staff member can only log as themselves, with their real role and the real server time
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(['actorUid', 'actorName', 'role', 'action', 'target', 'details', 'createdAt'])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.role == roleOf()
        && request.resource.data.createdAt == request.time
        && textOk(request.resource.data.action, 120)
        && textOk(request.resource.data.details, 500);
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // ---------- site settings & announcements ----------
    match /settings/{id} {
      allow read: if true; // maintenance flag / registration flag must be readable before login
      allow write: if isAdmin() && id == 'global'
        && request.resource.data.keys().hasOnly(['maintenance', 'maintenanceMessage', 'registrationOpen', 'botsEnabled', 'botToBotComments', 'updatedBy', 'updatedAt'])
        && request.resource.data.get('maintenance', false) is bool
        && request.resource.data.get('registrationOpen', true) is bool
        && request.resource.data.get('botsEnabled', true) is bool
        && request.resource.data.get('botToBotComments', false) is bool;
    }
    match /announcements/{id} {
      allow read: if signedIn();
      allow create, update: if isAdmin() && textOk(request.resource.data.text, 500);
      allow delete: if isAdmin();
    }

    // ---------- server jobs (GitHub Actions with a service account) ----------
    // Permanent account deletion: a super_admin files a request; the scheduled job does the work.
    match /deletionRequests/{uid} {
      allow read: if isSuper();
      allow create: if isSuper()
        && uid != request.auth.uid
        && !uid.matches('bot_.*')
        && !isStaffUid(uid)
        && request.resource.data.keys().hasOnly(['status', 'requestedBy', 'name', 'createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedBy == request.auth.uid;
      allow delete: if isSuper();
      allow update: if false;
    }
    match /system/{id} {
      allow read: if isSuper();
      allow write: if false;
    }

    // ---------- bot automation ----------
    match /botRunners/{uid} {
      allow read: if isOwner(uid);
      allow write: if false; // create by hand in the Firebase console
    }
    match /botState/{id} {
      allow read: if isBotRunner();
      allow write: if runnerOn();
    }
    // "Please answer my message": a POINTER to a chat message, never a copy of its text. The scheduled job reads the
    // message from the chat itself, answers, then blanks and deletes the row. Only the runner and a super_admin can
    // read it (moderators and ordinary admins cannot).
    // PHASE 1 (rollout): the old shape {text} is still accepted so browsers that cached the old script keep working.
    // PHASE 2 (a later change, after at least 24 hours): remove the legacy branch marked LEGACY below.
    match /botInbox/{id} {
      allow create: if notBanned()
        && botsOn()
        && request.resource.data.fromUid == request.auth.uid
        && isBotUser(request.resource.data.botId)
        && request.resource.data.handled == false
        && request.resource.data.chatId == pairId(request.auth.uid, request.resource.data.botId)
        && (
          (request.resource.data.keys().hasOnly(['fromUid', 'botId', 'chatId', 'messageId', 'handled', 'createdAt'])
            && request.resource.data.messageId is string
            && request.resource.data.messageId.size() > 0
            && request.resource.data.messageId.size() <= 40
            // the pointed-to message must exist in that chat and be the sender's own
            && get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)/messages/$(request.resource.data.messageId)).data.uid == request.auth.uid)
          // LEGACY (phase 1 only): old clients send the text itself
          || (request.resource.data.keys().hasOnly(['fromUid', 'botId', 'chatId', 'text', 'handled', 'createdAt'])
            && textOk(request.resource.data.text, 500))
        );
      allow read: if isBotRunner() || isSuper();
      // the runner can only record progress. It can never change who/what/where a row points to, and it can only blank a
      // text, never write one. lastError is a short code, not free text.
      allow update: if runnerOn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['handled', 'handledAt', 'answered', 'skipped', 'attempts', 'lastError', 'text'])
        && request.resource.data.get('answered', false) is bool
        && (request.resource.data.get('text', '') == resource.data.get('text', '') || request.resource.data.get('text', '') == '')
        && request.resource.data.handled is bool
        && request.resource.data.get('attempts', 0) is int
        && request.resource.data.get('attempts', 0) >= 0
        && request.resource.data.get('attempts', 0) <= 10
        && request.resource.data.get('lastError', '') is string
        && request.resource.data.get('lastError', '').size() <= 60
        && request.resource.data.get('skipped', '') is string
        && request.resource.data.get('skipped', '').size() <= 40;
      // the runner may delete a row only once it is answered/closed (handled) or after 7 days; a super_admin may always
      allow delete: if (runnerOn()
          && (resource.data.handled == true || request.time > resource.data.createdAt + duration.value(7, 'd')))
        || isSuper();
    }
    match /botLogs/{id} {
      allow create: if runnerOn() || isAdmin();
      allow read: if isStaff();
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---------- users ----------
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if
        (isOwner(uid)
          && nameOk(request.resource.data)
          && request.resource.data.name.size() >= 2
          && request.resource.data.banned == false
          && request.resource.data.get('isBot', false) == false
          && request.resource.data.get('verified', false) == false
          && request.resource.data.get('suspendedUntil', null) == null)
        // staff-only: seed an AI bot profile
        || (isAdmin()
          && uid.matches('bot_[0-9][0-9]')
          && request.resource.data.isBot == true
          && request.resource.data.banned == false
          && nameOk(request.resource.data));
      allow update: if
        // the user edits their own profile / settings (never roles, blocks, badges)
        (isOwner(uid)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['banned', 'isBot', 'verified', 'suspendedUntil'])
          && nameOk(request.resource.data))
        // admin: block, verify, suspend, edit basic info
        // (an admin cannot touch another staff member; only a super_admin can)
        || (isAdmin()
          && (isSuper() || !isStaffUid(uid))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['banned', 'verified', 'suspendedUntil', 'name', 'nameLower', 'bio', 'photo', 'cover'])
          && nameOk(request.resource.data))
        // moderator: temporary suspension of non-staff users only
        || (isMod()
          && !isStaffUid(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['suspendedUntil']))
        // admin: full control of a bot profile (it can never be turned into a normal user)
        || (isAdmin()
          && resource.data.get('isBot', false) == true
          && request.resource.data.isBot == true
          && nameOk(request.resource.data));
      allow delete: if isAdmin() && resource.data.get('isBot', false) == true;

      match /saved/{postId} {
        allow read, write: if isOwner(uid);
      }
    }

    // ---------- posts ----------
    match /posts/{postId} {
      allow read: if signedIn() && (
        resource.data.visibility == 'public'
        || request.auth.uid in resource.data.audience
        || (resource.data.visibility == 'group'
            && request.auth.uid in groupDoc(resource.data.groupId).members)
        || isStaff()
      );

      allow create: if
        (request.resource.data.uid == request.auth.uid
          && notBanned()
          && validPost(request.resource.data)
          && (request.resource.data.groupId == null
              || request.auth.uid in groupDoc(request.resource.data.groupId).members))
        // staff or the bot-runner posting as an AI bot: public, text/photo only, never a video
        || ((runnerOn() || isAdmin())
          && isBotUser(request.resource.data.uid)
          && validPost(request.resource.data)
          && request.resource.data.visibility == 'public'
          && request.resource.data.groupId == null
          && request.resource.data.videoUrl == '');

      allow update:
        // staff moderation: hide / restore, switch comments on or off
        if (isStaff()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden', 'commentsDisabled']))
        // bot-runner (one check of the kill switch for both cases): bump commentCount by one after commenting as a bot,
        // or add / change a reaction under a bot's own key
        || (runnerOn()
          && engagementOk(resource.data.uid)
          && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount'])
              && math.abs(request.resource.data.commentCount - resource.data.commentCount) <= 1)
            || (resource.data.visibility == 'public'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
              && request.resource.data.reactions.diff(resource.data.reactions).affectedKeys().hasOnly(botIds()))))
        // everybody else: their own reaction key, or a counter moved by exactly one step
        || (notBanned() && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
            && request.resource.data.reactions.diff(resource.data.reactions).affectedKeys().hasOnly([request.auth.uid])
            // my own reaction is removed, or is one of the six known types
            && (!(request.auth.uid in request.resource.data.reactions)
                || request.resource.data.reactions[request.auth.uid] in ['like', 'love', 'haha', 'wow', 'sad', 'angry']))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount'])
            && math.abs(request.resource.data.commentCount - resource.data.commentCount) <= 1)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shareCount'])
            && math.abs(request.resource.data.shareCount - resource.data.shareCount) <= 1)
        ));

      allow delete: if isOwner(resource.data.uid) || isStaff();

      match /comments/{cid} {
        allow read: if signedIn()
          && (isStaff() || canSeePost(get(/databases/$(database)/documents/posts/$(postId)).data));
        allow create: if
          (request.resource.data.uid == request.auth.uid // cheap check first: the runner (a bot's uid in the data) stops here
            && notBanned()
            && textOk(request.resource.data.text, 2000)
            && userMayComment(postId))
          // staff or the bot-runner commenting as an AI bot (public posts with comments on)
          || ((runnerOn() || isAdmin())
            && isBotUser(request.resource.data.uid)
            && request.resource.data.get('ai', false) == true // bot content must always be flagged as AI
            && textOk(request.resource.data.text, 2000)
            && botMayComment(postId));
        allow delete: if isOwner(resource.data.uid)
          || isOwner(get(/databases/$(database)/documents/posts/$(postId)).data.uid)
          || isStaff();
      }
    }

    // ---------- reports (staff only) ----------
    match /reports/{id} {
      allow create: if notBanned()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.status == 'open'
        && textOk(request.resource.data.details, 1000);
      allow read: if isStaff();
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'action', 'resolvedBy', 'resolvedAt'])
        && request.resource.data.status in ['open', 'resolved']
        && request.resource.data.get('resolvedBy', request.auth.uid) == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ---------- friends ----------
    match /friendRequests/{id} {
      allow read: if signedIn()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if notBanned()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to != request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.to
        && !exists(/databases/$(database)/documents/friendships/$(pairId(request.auth.uid, request.resource.data.to)));
      allow delete: if signedIn()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    match /friendships/{pair} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      // Only the receiver of a pending request can create the friendship.
      allow create: if notBanned()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() == 2
        && pair == pairId(request.resource.data.members[0], request.resource.data.members[1])
        && exists(/databases/$(database)/documents/friendRequests/$(
              (request.resource.data.members[0] == request.auth.uid
                ? request.resource.data.members[1]
                : request.resource.data.members[0]) + '_' + request.auth.uid));
      allow delete: if signedIn() && request.auth.uid in resource.data.members;
    }

    match /follows/{id} {
      allow read: if signedIn();
      allow create: if notBanned()
        && request.resource.data.follower == request.auth.uid
        && request.resource.data.followed != request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.followed;
      allow delete: if signedIn() && resource.data.follower == request.auth.uid;
    }

    // ---------- messaging ----------
    match /chats/{chatId} {
      allow get: if signedIn()
        && (resource == null || request.auth.uid in resource.data.members)
        // the bot-runner may open a private chat only when one member is an AI bot (it has to answer there)
        || (isBotRunner() && resource != null && resource.data.type == 'private' && resource.data.members.hasAny(botIds()));
      allow list: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if notBanned()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() >= 2
        && request.resource.data.members.size() <= 50
        && request.resource.data.type in ['private', 'group']
        && (request.resource.data.type == 'group'
            || (request.resource.data.members.size() == 2
                && chatId == pairId(request.resource.data.members[0], request.resource.data.members[1])));
      // Members never change, except by the creator of a group chat.
      allow update: if (signedIn()
          && request.auth.uid in resource.data.members
          && request.resource.data.type == resource.data.type
          && (request.resource.data.members == resource.data.members
              || (resource.data.type == 'group' && resource.data.createdBy == request.auth.uid)))
        // bot-runner: only the "last message" preview of a private chat, written as a bot member
        || (runnerOn()
          && resource.data.type == 'private'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastAt'])
          && isBotUser(request.resource.data.lastMessage.uid)
          && request.resource.data.lastMessage.uid in resource.data.members);

      match /messages/{mid} {
        allow read: if (signedIn()
            && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members)
          // bot-runner: only the recent history of a chat with an AI bot
          || (isBotRunner()
            && get(/databases/$(database)/documents/chats/$(chatId)).data.type == 'private'
            && get(/databases/$(database)/documents/chats/$(chatId)).data.members.hasAny(botIds()));
        allow create: if
          (request.resource.data.uid == request.auth.uid
            && notBanned()
            && textOk(request.resource.data.text, 4000)
            && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members)
          // bot-runner answering a user's message as the bot that is a member of this chat
          || (runnerOn()
            && isBotUser(request.resource.data.uid)
            && request.resource.data.get('ai', false) == true // bot content must always be flagged as AI
            && textOk(request.resource.data.text, 4000)
            && request.resource.data.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members);
        allow delete: if isOwner(resource.data.uid);
      }
    }

    // ---------- stories (visible to the author's audience for 24h) ----------
    match /stories/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.audience;
      allow create: if notBanned()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.audience is list
        && request.resource.data.audience.size() <= 1500
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt <= request.time + duration.value(25, 'h');
      allow delete: if isOwner(resource.data.uid) || isStaff();
    }

    // ---------- short videos ----------
    match /reels/{id} {
      allow read: if signedIn();
      allow create: if notBanned()
        && request.resource.data.uid == request.auth.uid
        && textOk(request.resource.data.caption, 500)
        && request.resource.data.likes == {};
      allow update: if notBanned()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
        && request.resource.data.likes.diff(resource.data.likes).affectedKeys().hasOnly([request.auth.uid]);
      allow delete: if isOwner(resource.data.uid) || isStaff();
    }

    // ---------- groups ----------
    match /groups/{gid} {
      allow read: if signedIn();
      allow create: if notBanned()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.privacy in ['public', 'private']
        && textOk(request.resource.data.name, 80)
        && request.resource.data.name.size() >= 2;
      allow update: if signedIn() && (
        (resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid)
        // join a public group
        || (resource.data.privacy == 'public'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.toSet().difference(resource.data.members.toSet()).hasOnly([request.auth.uid])
          && resource.data.members.toSet().difference(request.resource.data.members.toSet()).size() == 0)
        // leave a group
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.toSet().difference(resource.data.members.toSet()).size() == 0
          && resource.data.members.toSet().difference(request.resource.data.members.toSet()).hasOnly([request.auth.uid]))
      );
      allow delete: if isOwner(resource.data.ownerUid) || isStaff();

      match /requests/{uid} {
        allow create: if isOwner(uid) && notBanned();
        allow read, delete: if isOwner(uid)
          || (signedIn() && get(/databases/$(database)/documents/groups/$(gid)).data.ownerUid == request.auth.uid);
      }
    }

    // ---------- notifications ----------
    match /notifications/{id} {
      allow read: if signedIn() && resource.data.to == request.auth.uid;
      allow create: if (notBanned()
          && request.resource.data.from == request.auth.uid
          && request.resource.data.to is string
          && request.resource.data.to != request.auth.uid)
        // bot-runner telling a user that a bot commented / replied
        || (runnerOn()
          && isBotUser(request.resource.data.from)
          && request.resource.data.to is string);
      allow update: if signedIn() && resource.data.to == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if signedIn() && resource.data.to == request.auth.uid;
    }
  }
}
